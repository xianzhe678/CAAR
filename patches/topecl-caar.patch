+def stratified_holdout_indices(targets, samples_per_class, seed):
+    """Return a deterministic class-balanced hold-out split.
+
+    The split is computed once from the training targets and is independent of
+    DataLoader order or training RNG consumption.  Returned indices are sorted
+    so the resulting datasets also have deterministic sample order.
+    """
+    targets = np.asarray(targets)
+    samples_per_class = int(samples_per_class)
+    seed = int(seed)
+    if samples_per_class <= 0:
+        raise ValueError("samples_per_class must be positive")
+
+    rng = np.random.default_rng(seed)
+    validation = []
+    for class_id in np.unique(targets):
+        class_indices = np.flatnonzero(targets == class_id)
+        if samples_per_class >= len(class_indices):
+            raise ValueError(
+                "validation hold-out must leave at least one training sample "
+                "for class {} (requested {}, available {})".format(
+                    int(class_id), samples_per_class, len(class_indices)
+                )
+            )
+        validation.extend(
+            rng.choice(class_indices, samples_per_class, replace=False).tolist()
+        )
+
+    validation = np.asarray(sorted(validation), dtype=np.int64)
+    keep = np.ones(len(targets), dtype=bool)
+    keep[validation] = False
+    training = np.flatnonzero(keep).astype(np.int64, copy=False)
+    return training, validation
+
