+def class_aligned_batches(targets, batch_size):
+    """Return class-pure batches while preserving class and sample order.
+
+    The public implementation creates a new DataLoader for every class.  On
+    Windows that repeatedly starts worker processes.  A single DataLoader with
+    this batch sampler produces the same per-class batches without that cost.
+    """
+    if batch_size <= 0:
+        raise ValueError('batch_size must be positive')
+    targets = np.asarray(targets)
+    if targets.ndim != 1:
+        raise ValueError('targets must be one-dimensional')
+    batches = []
+    for cls_id in np.unique(targets):
+        indices = np.flatnonzero(targets == cls_id)
+        for start in range(0, len(indices), batch_size):
+            batches.append(indices[start:start + batch_size].tolist())
+    return batches
+
+
+def _preserve_legacy_loader_rng(class_count):
+    """Match the parent-process RNG advancement of one loader per class.
+
+    Creating a DataLoader iterator consumes one random 64-bit base seed even
+    when ``shuffle=False``.  The fused path creates one iterator, whereas the
+    public implementation creates one per class.  Consuming the missing base
+    seeds keeps all later seeded training operations aligned with the legacy
+    path.
+    """
+    if class_count < 1:
+        raise ValueError('class_count must be positive')
+    for _ in range(class_count - 1):
+        torch.empty((), dtype=torch.int64).random_().item()
